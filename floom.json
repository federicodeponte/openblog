{
  "name": "OpenBlog",
  "description": "AI-powered SEO blog article generator",
  "actions": {
    "generate": {
      "label": "Generate Articles",
      "description": "Generate new blog articles from keywords and a company URL",
      "feedback": true,
      "inputs": [
        {
          "name": "url",
          "type": "url",
          "label": "Company Website URL",
          "required": true
        },
        {
          "name": "keywords",
          "type": "textarea",
          "label": "Keywords (one per line)",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "preview",
          "label": "Article Preview",
          "type": "html"
        },
        {
          "name": "markdown",
          "label": "Markdown Source",
          "type": "markdown"
        },
        {
          "name": "raw",
          "label": "Raw Response",
          "type": "json"
        }
      ]
    },
    "refresh": {
      "label": "Refresh Article",
      "description": "Re-run quality checks and URL verification on an existing article",
      "inputs": [
        {
          "name": "article_data",
          "type": "file",
          "label": "Article (JSON, CSV, HTML, or paste text)",
          "accept": ".json,.csv,.html,.txt",
          "parse_to": "json",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "preview",
          "label": "Article Preview",
          "type": "html"
        },
        {
          "name": "markdown",
          "label": "Markdown Source",
          "type": "markdown"
        },
        {
          "name": "raw",
          "label": "Raw Response",
          "type": "json"
        }
      ]
    }
  },
  "python_dependencies": [
    "google-genai>=1.0",
    "httpx",
    "pydantic>=2.0",
    "python-dotenv",
    "defusedxml>=0.7",
    "markdownify",
    "openpyxl"
  ],
  "secrets_needed": [
    "GEMINI_API_KEY"
  ],
  "manifest_version": "2.0",
  "knowledge_enabled": true
}